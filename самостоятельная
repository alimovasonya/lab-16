#include <stdio.h>

int count_key(const int a[], int n, int key) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] == key) {
            count++;
        }
    }
    return count;
}

int first_key(const int a[], int n, int key) {
    for (int i = 0; i < n; i++) {
        if (a[i] == key) {
            return i;
        }
    }
    return -1;
}

int main(void) {
    int a[] = {2, 7, 2, -1, 2};
    int n = 5;
    int keys_to_test[] = {2, 7, 9};
    int num_tests = 3;
    
    for (int i = 0; i < num_tests; i++) {
        int key = keys_to_test[i];
        printf("key=%d: Количество %d; индекс %d\n", key, count_key(a, n, key), first_key(a, n, key));
    }
    
    int empty_arr[] = {0};
    int empty_n = 0;
    int test_key = 5;
    printf("Свой тест (пустой массив, key=%d): Количество %d; индекс %d\n", 
           test_key, count_key(empty_arr, empty_n, test_key), first_key(empty_arr, empty_n, test_key));

    return 0;
}
